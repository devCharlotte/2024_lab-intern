#include <linux/fs.h>
#include <linux/init.h>
#include <linux/kobject.h>
#include <linux/module.h>
#include <linux/string.h>
#include <linux/sysfs.h>

static struct kobject *mymodule;

// show / store 가 실제로 부를 함수들, 다른 모듈에서 myop 를 바꿔 끼울 수 있음
struct my_operations {
	ssize_t (*traverse)(char *buf);
	ssize_t (*insert)(const char *buf, size_t count);
};

int myvariable = 0;
EXPORT_SYMBOL(myvariable);

static ssize_t mytraverse(char *buf)
{
	return sysfs_emit(buf, "%d\n", myvariable);
}

static ssize_t myinsert(const char *buf, size_t count)
{
	int val;

	if (kstrtoint(buf, 10, &val))
		return -EINVAL;
	myvariable = val;
	return count;
}

static struct my_operations default_op = {
	.traverse = mytraverse,
	.insert = myinsert,
};

struct my_operations *myop;
EXPORT_SYMBOL(myop);

static ssize_t myvariable_show(struct kobject *kobj,
			       struct kobj_attribute *attr, char *buf)
{
	if (!myop || !myop->traverse)
		return -ENODEV;
	return myop->traverse(buf);
}

static ssize_t myvariable_store(struct kobject *kobj,
				struct kobj_attribute *attr, const char *buf,
				size_t count)
{
	if (!myop || !myop->insert)
		return -ENODEV;
	return myop->insert(buf, count);
}

static struct kobj_attribute myvariable_attribute =
	__ATTR(myvariable, 0660, myvariable_show, myvariable_store);

static int __init mymodule_init(void)
{
	int error;

	pr_info("mymodule: initialised\n");

	myop = &default_op;

	mymodule = kobject_create_and_add("mymodule", kernel_kobj);
	if (!mymodule)
		return -ENOMEM;

	error = sysfs_create_file(mymodule, &myvariable_attribute.attr);
	if (error) {
		pr_info("failed to create the myvariable file "
			"in /sys/kernel/mymodule\n");
		kobject_put(mymodule);
	}

	return error;
}

static void __exit mymodule_exit(void)
{
	pr_info("mymodule: Exit success\n");
	kobject_put(mymodule);
}

module_init(mymodule_init);
module_exit(mymodule_exit);

MODULE_LICENSE("GPL");
